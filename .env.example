# Dùng cho docker compose. Sao chép thành .env rồi sửa giá trị.
# Tạo bí mật: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
APP_PORT=8080
CLIENT_ORIGIN=http://localhost:8080
# Đặt true khi chạy sau reverse proxy có HTTPS
TRUST_PROXY=false
MAX_FILE_SIZE_MB=200
DEFAULT_QUOTA_MB=2048
