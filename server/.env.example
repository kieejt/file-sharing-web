NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/fileshare

# Bí mật ký token: chuỗi ngẫu nhiên >= 32 ký tự
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Thời gian sống
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Lưu trữ
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=200
DEFAULT_QUOTA_MB=2048
TRASH_RETENTION_DAYS=30

# Domain frontend (CORS), cách nhau bởi dấu phẩy
CLIENT_ORIGIN=http://localhost:5173
# Đặt true khi chạy sau reverse proxy (nginx, load balancer)
TRUST_PROXY=false
